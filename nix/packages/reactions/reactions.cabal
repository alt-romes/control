cabal-version:      3.0
name:               reactions
version:            0.1.0
synopsis:           Run the programs declared to react to control-events
build-type:         Simple

executable reactions
  main-is:          Main.hs
  hs-source-dirs:   .
  ghc-options:      -Wall -threaded
  default-language: GHC2021
  default-extensions:
    BlockArguments
    DeriveAnyClass
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
  build-depends:
      aeson
    , async
    , base
    , control-events
    , net-mqtt
    , text
    , typed-process
