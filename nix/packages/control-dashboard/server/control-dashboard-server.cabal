cabal-version:      3.0
name:               control-dashboard-server
version:            0.3.0
synopsis:           Judges what control-events say, for the dashboard's windows
build-type:         Simple

common shared
  ghc-options:      -Wall
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    LambdaCase
    BlockArguments
    DeriveAnyClass
    DerivingStrategies
    NamedFieldPuns
  build-depends:
      aeson
    , base
    , containers
    , control-events
    , net-mqtt
    , text
    , time
    , uuid

executable control-dashboard-server
  import:           shared
  main-is:          Main.hs
  other-modules:    Model
  hs-source-dirs:   app
  ghc-options:      -threaded
  build-depends:
      async
    , bytestring
    , directory
    , filepath
    , http-types
    , stm
    , wai
    , wai-websockets
    , warp
    , websockets

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test app
  other-modules:    Model
